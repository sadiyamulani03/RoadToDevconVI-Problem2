# === Coin Purse: buyer wallet credentials (SECRETS - never commit) ===
# Funded Base Sepolia testnet wallet private key for LIVE runs.
# Leave empty for local demos: a throwaway unfunded wallet is generated.
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# === LLM credentials (SECRETS - never commit) ===
# OpenAI-compatible chat completions endpoint. Leave empty to use the
# deterministic offline planner (no LLM calls).
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# === Spending policy (trusted configuration, not secrets) ===
# Hard per-call ceiling in base units. 1,000,000 base units = 1 USDC (6 decimals).
MAX_CALL_AMOUNT_BASE_UNITS=1000000
# Total run budget in base units. 5,000,000 base units = 5 USDC.
TOTAL_RUN_BUDGET_BASE_UNITS=5000000

# === Network and asset allowlists (not secrets) ===
ALLOWED_NETWORK=base-sepolia
# The allowed payment asset contract address. For a LIVE Base Sepolia run,
# set this to the USDC contract on Base Sepolia:
#   0x036CbD53842c5426634e7929541eC2318f3dCF7e
ALLOWED_ASSET=YOUR_BASE_SEPOLIA_ASSET_ADDRESS
ALLOWED_ASSET_DECIMALS=6

# === x402 / infra (not secrets) ===
X402_VERSION=1
# Facilitator for payment verification/settlement. For live testnet runs use
# https://x402.org/facilitator ; for the local demo a local facilitator is
# started automatically on an ephemeral port.
FACILITATOR_URL=http://127.0.0.1:4020
RPC_URL=https://sepolia.base.org
LEDGER_DB_PATH=./data/ledger.sqlite

# === Local seller ports (not secrets) ===
HONEST_PORT=4021
ROGUE_PORT=4022
