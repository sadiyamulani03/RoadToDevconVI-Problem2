{
  "name": "x402-coin-purse-agent",
  "version": "1.0.0",
  "description": "Problem 2: The Coin Purse - An Agent That Pays but Can't Be Drained. A research agent with a secure x402 coin purse policy.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:honest": "node dist/sellers/honest-server.js",
    "start:rogue": "node dist/sellers/rogue-server.js",
    "start:facilitator": "node dist/sellers/local-facilitator.js",
    "demo:honest": "tsx src/demo/run-demo.ts --seller honest",
    "demo:rogue": "tsx src/demo/run-demo.ts --seller rogue",
    "agent": "tsx src/agent/run-agent.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "x402",
    "base",
    "agent",
    "payments",
    "security"
  ],
  "author": "sadiyamulani03",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "viem": "^2.38.0",
    "x402": "^0.6.6",
    "x402-express": "^0.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "express": "^5.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
